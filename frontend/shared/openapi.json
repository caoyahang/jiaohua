    "/health": {
      "get": {
        "summary": "健康检查",
        "description": "健康检查：自身存活 + 依赖（PostgreSQL/Redis/TDengine）连通性。\n\n依赖不可达时返回 degraded 而非 500，便于负载均衡探活与运维定位。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AckRequest": {
        "properties": {
          "handler": {
            "type": "string",
            "title": "Handler",
            "description": "处理人"
          },
          "comment": {
            "type": "string",
            "title": "Comment",
            "description": "处置意见",
            "default": ""
          },
          "is_false_positive": {
            "type": "boolean",
            "title": "Is False Positive",
            "description": "是否误报（回流用于模型迭代）",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "handler"
        ],
        "title": "AckRequest",
        "description": "告警确认请求。"
      },
      "AckResponse": {
        "properties": {
          "alarm_id": {
            "type": "integer",
            "title": "Alarm Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "alarm_id",
          "status"
        ],
        "title": "AckResponse",
        "description": "POST /vision/alarms/{id}/ack 响应。"
      },
      "BlendSolution": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "方案类型：cost_optimal/quality_stable/balanced"
          },
          "blend_ratio": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Blend Ratio",
            "description": "各煤种配比（和为1）"
          },
          "estimated_cost": {
            "type": "number",
            "title": "Estimated Cost",
            "description": "预估吨煤成本 元/吨"
          },
