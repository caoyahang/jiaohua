{
  "openapi": "3.1.0",
  "info": {
    "title": "AI焦化厂智能化平台 API",
    "description": "智能配煤 / 焦炉加热控制 / 设备PdM / 安全视觉 四大应用后端",
    "version": "1.1.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登录签发token",
        "description": "校验账号密码，签发JWT。失败统一返回401，不区分用户不存在/密码错误。",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/blend/optimize": {
      "post": {
        "tags": [
          "智能配煤"
        ],
        "summary": "调配煤优化器",
        "description": "运行配煤优化：GA(scikit-opt)寻优 + 质量预测模型评估 + 边际贡献解释。\n\n返回3套方案：cost_optimal / quality_stable / balanced（4.1.5输出规范）。\n优化器本体在 models/blending_optimizer/，此处只做参数校验与调用编排。",
        "operationId": "optimize_blend_optimize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/blend/recipes": {
      "get": {
        "tags": [
          "智能配煤"
        ],
        "summary": "历史配煤方案查询",
        "description": "查询PostgreSQL blend_recipe表（3.4.1节），支持按焦炉号过滤。",
        "operationId": "list_recipes_blend_recipes_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "furnace_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Furnace Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/blend/feedback": {
      "post": {
        "tags": [
          "智能配煤"
        ],
        "summary": "化验结果回流，触发增量学习",
        "description": "化验数据闭环（4.1.7节）：\n\n1. 取该批次当时的预测值 → 2. 计算误差 → 3. 超阈值写入误差缓冲区(Redis)\n→ 4. 缓冲区满 BUFFER_TRIGGER_SIZE 条触发增量微调（LightGBM热启动，小学习率防遗忘）。",
        "operationId": "feedback_blend_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabFeedback"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/furnace/temp": {
      "get": {
        "tags": [
          "焦炉加热控制"
        ],
        "summary": "实时炉温",
        "description": "查询TDengine中该焦炉最近一次的机/焦侧火道温度。\n\n注意：换向前后2~3分钟数据为脏数据（4.2.6节），\n由ETL管道打标记，此处查询应过滤 switching_flag=0。",
        "operationId": "get_temp_furnace_temp_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "furnace_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Furnace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/furnace/ai-setpoint": {
      "get": {
        "tags": [
          "焦炉加热控制"
        ],
        "summary": "AI设定值建议",
        "description": "MPC求解最优煤气流量/吸力设定值（4.2.4节），输出前经 clamp_setpoint 钳位。\n\nshadow模式下仅展示不下发；auto模式由控制回路消费本接口结果。",
        "operationId": "get_ai_setpoint_furnace_ai_setpoint_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "furnace_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Furnace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/furnace/control-mode": {
      "post": {
        "tags": [
          "焦炉加热控制"
        ],
        "summary": "切换控制模式",
        "description": "切换 manual/shadow/auto。\n\n状态存Redis（key: furnace:control_mode:{furnace_id}），Redis不可用时落内存。\n注意：「一键切手动」为DCS硬切换（4.2.6节），本接口只是AI系统侧的模式记录，\n不构成安全通路。",
        "operationId": "set_control_mode_furnace_control_mode_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlModeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlModeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/furnace/k-coefficients": {
      "get": {
        "tags": [
          "焦炉加热控制"
        ],
        "summary": "热工K系数查询",
        "description": "返回K均/K安/K1/K2/K3（4.2.6节统一考核口径）。\n\n计算逻辑在 data/pipeline/k_coefficients.py（直行温度记录+推焦计划/执行记录），\n本接口只做查询编排。",
        "operationId": "get_k_coefficients_furnace_k_coefficients_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "furnace_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Furnace Id"
            }
          },
          {
            "name": "shift_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Shift Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pdm/devices": {
      "get": {
        "tags": [
          "设备PdM"
        ],
        "summary": "监控设备列表",
        "description": "返回监控设备清单，支持按优先级P0/P1/P2过滤。",
        "operationId": "list_devices_pdm_devices_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^P[012]$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
