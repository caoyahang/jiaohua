    "/health": {
      "get": {
        "summary": "健康检查",
        "description": "健康检查：自身存活 + 依赖（PostgreSQL/Redis/TDengine）连通性。\n\n依赖不可达时返回 degraded 而非 500，便于负载均衡探活与运维定位。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
