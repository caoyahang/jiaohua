  "components": {
    "schemas": {
      "AckRequest": {
        "properties": {
          "handler": {
            "type": "string",
            "title": "Handler",
            "description": "处理人"
          },
          "comment": {
            "type": "string",
            "title": "Comment",
            "description": "处置意见",
            "default": ""
          },
          "is_false_positive": {
            "type": "boolean",
            "title": "Is False Positive",
            "description": "是否误报（回流用于模型迭代）",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "handler"
        ],
        "title": "AckRequest",
        "description": "告警确认请求。"
      },
      "CoalInfo": {
        "properties": {
          "coal_id": {
            "type": "integer",
            "title": "Coal Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "stock_tons": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Stock Tons",
            "description": "库存量 吨"
          },
          "price_per_ton": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price Per Ton",
            "description": "单价 元/吨"
          },
          "min_ratio": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Ratio",
            "description": "配比下限（工艺约束）",
            "default": 0.0
          },
          "max_ratio": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Max Ratio",
            "description": "配比上限（工艺约束）",
            "default": 1.0
          },
          "lab_data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Lab Data",
            "description": "化验指标：Ad/Vdaf/St_d/G/Y/Rmax等"
          }
        },
        "type": "object",
        "required": [
          "coal_id",
          "name",
          "stock_tons",
          "price_per_ton"
        ],
        "title": "CoalInfo",
